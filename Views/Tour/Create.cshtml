@model TourismMVC.Models.Tour

<h2>Create a New Tour</h2>
<form asp-action="Create" method="post">
    <input asp-for="Title" placeholder="Title" required /><br />
    <textarea asp-for="Description" placeholder="Description"></textarea><br />
    <input asp-for="Price" placeholder="Price" required /><br />
    <input asp-for="Date" type="date" required /><br />
    <button type="submit">Create</button>
</form>
